{
  "name": "charakterbogen",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Digitaler D&D-5e-Charakterbogen (Edition 2014) als einzelne HTML-Datei",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run build && npm run build:web && playwright test",
    "test:legacy": "cross-env TARGET=legacy playwright test --grep-invert @new",
    "screens": "node scripts/screenshots.mjs",
    "lint": "eslint src",
    "build:web": "vite build --mode web",
    "test:live": "cross-env LIVE_REAL=1 playwright test tests/live.spec.js --grep @real"
  },
  "devDependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans-sc": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.119.0",
    "fuse.js": "^7.5.0"
  }
}
